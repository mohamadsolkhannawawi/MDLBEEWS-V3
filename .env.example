# ==============================================================================
# EEWS Microservices — Centralized Environment Configuration (Template)
# Copy this file to `.env` and modify values if needed.
# ==============================================================================

# --- Kafka Cluster ---
KAFKA_BROKER_1=kafka1:9092
KAFKA_BROKER_2=kafka2:9093
KAFKA_BROKER_3=kafka3:9094
KAFKA_BROKERS=kafka1:9092,kafka2:9093
KAFKA_BROKERS_ALL=kafka1:9092,kafka2:9093,kafka3:9094
KAFKA_BROKERS_PWAVE=kafka3:9094
KAFKA_LOG_RETENTION_MS=600000
KAFKA_NUM_PARTITIONS=5

# --- Kafka Topics ---
KAFKA_TOPIC_TRACE=trace_topic
KAFKA_TOPIC_PWAVE=p_wave_topic
KAFKA_TOPIC_LOCMAG=loc_mag_topic
KAFKA_TOPIC_RESULT=result_loc_mag_topic

# --- InfluxDB ---
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=eFWu0UGcCzvGAX1w-z43heHjfDk8swujfryImhIsTrAkNJOgfMRSYsgYVki-QTiWHDwKLJtxsSnCmHhxisCN1w==
INFLUXDB_ORG=owner
INFLUXDB_BUCKET=eews

# --- MongoDB ---
MONGO_URL=mongodb://mongo:27017/

# --- Grafana ---
GF_SERVER_ROOT_URL=http://localhost:4000
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=12345678

# --- Prometheus Metrics Toggle ---
ENABLE_METRICS=true

# --- Prometheus Metrics Ports per Module ---
METRICS_PORT_DATA_PROVIDER=8101
METRICS_PORT_PWAVE_DETECTOR=8102
METRICS_PORT_PWAVE_DETECTOR_LB=8103
METRICS_PORT_LOAD_BALANCER=8104
METRICS_PORT_LOCMAG_DETECTOR=8105
METRICS_PORT_DATA_ARCHIVER=8106
METRICS_PORT_API_SERVER=8107
METRICS_PORT_FAST_API=8108

# --- Prometheus Server ---
PROMETHEUS_SCRAPE_INTERVAL=5s
PROMETHEUS_PORT=9090

# --- Data Provider ---
SEEDLINK_SERVER=rtserve.iris.washington.edu:18000
DATA_PROVIDER_NUM_PROCESSES=30
DATA_PROVIDER_NUM_STATIONS=50
